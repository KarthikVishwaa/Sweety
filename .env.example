# Runtime mode: development, test or production.
NODE_ENV=development
# Port the API listens on.
PORT=4000
# The only origin allowed by CORS (credentials are enabled). Matches the Vite dev server.
CLIENT_URL=http://localhost:5173
# PostgreSQL connection string. Docker compose publishes Postgres on host port 5434.
DATABASE_URL=postgres://sweety:sweety_dev_password@localhost:5434/sweety
# Redis connection string. Docker compose publishes Redis on host port 6380. No feature uses it yet.
REDIS_URL=redis://localhost:6380
# Secret used to sign auth tokens, minimum 32 characters. Left empty on purpose so the server refuses to start until you set it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Token and cookie lifetime, for example 15m or 1h.
JWT_EXPIRES_IN=15m
# Time zone used to decide what "today" is (future-date checks, seed data).
TZ=Asia/Kolkata
# Send the auth cookie over HTTPS only. Defaults to true when NODE_ENV=production, otherwise false.
# Set it to false to run a production build over plain http://localhost (the Docker "full" profile does this).
COOKIE_SECURE=false
# How many reverse proxies sit in front of the API (0 when none). Set to 1 behind the bundled nginx so rate limiting sees real client IPs.
TRUST_PROXY=0
# Lets "npm run seed" run when NODE_ENV=production. Only for throwaway demo stacks; leave false everywhere else.
ALLOW_DEMO_SEED=false
